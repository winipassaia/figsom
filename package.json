{
  "name": "figsom",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Crie e envie figurinhas com som no WhatsApp a partir de qualquer vídeo",
  "main": "app/main.js",
  "scripts": {
    "start": "node index.js",
    "app": "electron .",
    "dist:win": "electron-builder --win",
    "dist:linux": "electron-builder --linux"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "dependencies": {
    "baileys": "7.0.0-rc14",
    "pino": "^9.14.0",
    "qrcode": "^1.5.4",
    "qrcode-terminal": "^0.12.0"
  },
  "devDependencies": {
    "electron": "^39.8.10",
    "electron-builder": "^26.18.0"
  },
  "author": "winipassaia",
  "homepage": "https://github.com/winipassaia/figsom",
  "build": {
    "appId": "io.github.winipassaia.figsom",
    "productName": "figsom",
    "copyright": "© 2026 winipassaia — MIT",
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "files": [
      "app/**/*",
      "!app/demo.js",
      "src/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "vendor/ffmpeg",
        "to": "ffmpeg"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "figsom",
      "artifactName": "figsom-${version}-instalador-windows.${ext}"
    },
    "portable": {
      "artifactName": "figsom-${version}-portatil-windows.${ext}"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Utility",
      "icon": "build/icon.png",
      "artifactName": "figsom-${version}-linux.${ext}"
    }
  }
}
